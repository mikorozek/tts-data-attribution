# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test, type-check, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local.yaml
*.local.yml

# Editors, notebooks, and OS
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/

# Logs and cluster outputs
*.log
slurm-*.out
slurm-*.err
/wandb/
/runs/
/outputs/
/checkpoints/

# Model and optimizer artifacts
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf

# Audio and generated media
*.wav
*.flac
*.mp3
*.ogg
*.opus
*.m4a

# Dataset payloads and derived caches. Tracked manifests and split files remain allowed.
/data/raw/
/data/downloads/
/data/processed/
/data/cache/

# Framework artifacts. Keep only the documentation files below.
/artifacts/models/*
/artifacts/runs/*
/artifacts/cache/
/artifacts/gradients/
/artifacts/checkpoints/
/artifacts/outputs/

# Hugging Face and other local downloader caches
**/.cache/huggingface/

# Temporary upstream clones
/third_party/.tmp/

# Paper PDFs, source/license manifests, consumed configs, source code, tests,
# and small deterministic metadata manifests are intentionally NOT ignored.
